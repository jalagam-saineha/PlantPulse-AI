# Copy this file to .env and adjust values as needed.
# .env is loaded automatically by app.py via python-dotenv.

# development shows password-reset links on screen + terminal.
# production disables that and requires MAIL_ENABLED for password reset delivery.
APP_ENV=development

# Generate a real random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Optional SQLAlchemy database URL override (defaults to instance/plantpulse.db)
# DATABASE_URL=sqlite:///instance/plantpulse.db

PORT=5000

# AI outputs below this confidence are labeled uncertain (percentage).
# Held-out evaluation (8,179 images): 60% accepted 96.77% at 97.16% accuracy.
# This is an adjustable screening rule, not a calibrated diagnosis cutoff.
AI_CONFIDENCE_THRESHOLD=60

# Optional AI provider for the Care Assistant. Set to "openai" or "gemini".
# Leave the selected provider's API key empty to use the labelled fallback.
# PLANTPULSE_AI_PROVIDER=gemini
# PLANTPULSE_AI_API_KEY=
# PLANTPULSE_AI_API_URL=https://api.openai.com/v1/chat/completions
# PLANTPULSE_AI_MODEL=gpt-4o-mini
# Gemini API (Google AI Studio)
# PLANTPULSE_GEMINI_API_KEY=
# PLANTPULSE_GEMINI_MODEL=gemini-3.5-flash-lite
# PLANTPULSE_AI_TIMEOUT=12

# --- Optional SMTP for password reset emails ---
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@plantpulse.local
MAIL_USE_TLS=true
